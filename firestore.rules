rules_version = '2';

// Data lives at groups/{groupId}/games/{gameId}.
// groupId is the SHA-256 of the shared passcode (64 hex chars), so knowing the
// passcode is what grants access. The `groups` collection itself can't be listed,
// so groups can't be enumerated. Games are never hard-deleted: a deleted game is
// overwritten with a small "tombstone" doc (deleted: true, no data).
service cloud.firestore {
  match /databases/{database}/documents {
    match /groups/{groupId}/games/{gameId} {
      allow read: if groupId.size() == 64;

      allow create, update: if groupId.size() == 64
        && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'deleted'])
        && request.resource.data.keys().hasAll(['updatedAt', 'deleted'])
        && request.resource.data.updatedAt is int
        && request.resource.data.deleted is bool
        && (!('data' in request.resource.data)
            || (request.resource.data.data is string && request.resource.data.data.size() < 500000));

      allow delete: if false;
    }
  }
}
