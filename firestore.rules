rules_version = '2';

// Data lives at groups/{groupId}/games/{gameId}. The app uses one fixed 64-char
// random groupId (SHARED_GROUP_ID in src/lib/sync/config.ts), so everyone who opens
// the app shares the same data with no login. The `groups` collection itself can't be
// listed, and a game's path can't be guessed without that id. Games are never
// hard-deleted: a deleted game is overwritten with a small "tombstone" doc
// (deleted: true, no data).
service cloud.firestore {
  match /databases/{database}/documents {
    match /groups/{groupId}/games/{gameId} {
      allow read: if groupId.size() == 64;

      allow create, update: if groupId.size() == 64
        && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'deleted'])
        && request.resource.data.keys().hasAll(['updatedAt', 'deleted'])
        && request.resource.data.updatedAt is int
        && request.resource.data.deleted is bool
        && (!('data' in request.resource.data)
            || (request.resource.data.data is string && request.resource.data.data.size() < 500000));

      allow delete: if false;
    }
  }
}
